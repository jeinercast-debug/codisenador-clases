# Copiá este archivo a ".env" y pegá tu clave de la API de Claude.
# La conseguís en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional — modelo a usar (por defecto: claude-sonnet-5)
# Para máxima calidad podés usar claude-opus-5 (más lento y costoso).
# ANTHROPIC_MODEL=claude-sonnet-5

# Opcional — puerto (por defecto: 5173)
# PORT=5173
